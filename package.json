{
  "name": "onramp-adapter-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Holds the Meld API key and returns scoped, single-buyer widget URLs. The key never reaches a client.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src test scripts vitest.config.ts vitest.e2e.config.ts",
    "start": "node dist/main.js",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "check:chart": "node scripts/check-chart.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/proxy-addr": "5.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@polkadot/util": "^14",
    "@polkadot/util-crypto": "^14.0.3",
    "fastify": "^5",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "verifiablejs": "1.3.0-beta.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "js-yaml": "5.4.1",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paritytech/onramp-adapter-service-community.git"
  },
  "license": "GPL-3.0-or-later",
  "overrides": {
    "@polkadot/util": "^14",
    "qs": "^6.15.2"
  }
}
